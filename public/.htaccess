Options -Indexes -MultiViews
RewriteEngine On

RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(includes|logs)(/|$) - [F,L]
RewriteRule \.(bak|old|orig|tmp|temp|swp|swo|log|sql|ini|conf|ya?ml|lock|dist|backup|zip|tar|tgz|gz)$ - [F,L]

# Route only known application pages through the nonce-aware HTML responder.
# API, asset, and realtime paths do not match these rules.
RewriteRule ^$ html.php?page=index [END,QSA]
RewriteRule ^(activate|admin|analytics|assignment|assignments|course|forgot-password|grading|index|lesson|manager|modules|projector|quiz|quizzes|resource-viewer|reset-password|room|settings|ta)(?:\.html)?/?$ html.php?page=$1 [END,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Resource-Policy
</IfModule>
