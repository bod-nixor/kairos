Options -Indexes -MultiViews
RewriteEngine On

RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(includes|logs)(/|$) - [F,L]
RewriteRule \.(bak|old|orig|tmp|temp|swp|swo|log|sql|ini|conf|ya?ml|lock|dist|backup|zip|tar|tgz|gz)$ - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-adYjF4JX+UAi8dTwQ8EYYdIe3YS0ex+t/N88W5dXQR8=' 'sha256-m8G8qo5FTSqY7S2OLIFrv8z/A5blMhLqu0FiRUV6x04=' 'sha256-s9cYKQFeCMGeF/qWfalBvW6Zgs2dwLFQEz5iyw3N0VE=' 'sha256-REmP8BFUiFylrrB0OOC4BtDoxaa4PqduZcr88Yq1Rc4=' 'sha256-DAOy9D49M+a8vIKcA1ZL2XYm6A6HEX2IaYE6L+YY4+8=' 'sha256-RCA8w6++dfae0mC6GnKRaB0bsd9bUitnGFq/hBliNzk=' 'sha256-KdMjE/VcXBmqMZ7kOsyswcveVZArMZP5LScMQZTZfyY=' 'sha256-qH1Ad5P//u5MQTuBqW0ZNZhCn2uP5p17OYRCzLgN600=' 'sha256-io8VSPOIMfyAJMML4ckll5fEoWACwOTj0jnnw/wPv24=' https://accounts.google.com https://apis.google.com https://www.gstatic.com; script-src-elem 'self' 'sha256-adYjF4JX+UAi8dTwQ8EYYdIe3YS0ex+t/N88W5dXQR8=' 'sha256-m8G8qo5FTSqY7S2OLIFrv8z/A5blMhLqu0FiRUV6x04=' 'sha256-s9cYKQFeCMGeF/qWfalBvW6Zgs2dwLFQEz5iyw3N0VE=' 'sha256-REmP8BFUiFylrrB0OOC4BtDoxaa4PqduZcr88Yq1Rc4=' 'sha256-DAOy9D49M+a8vIKcA1ZL2XYm6A6HEX2IaYE6L+YY4+8=' 'sha256-RCA8w6++dfae0mC6GnKRaB0bsd9bUitnGFq/hBliNzk=' 'sha256-KdMjE/VcXBmqMZ7kOsyswcveVZArMZP5LScMQZTZfyY=' 'sha256-qH1Ad5P//u5MQTuBqW0ZNZhCn2uP5p17OYRCzLgN600=' 'sha256-io8VSPOIMfyAJMML4ckll5fEoWACwOTj0jnnw/wPv24=' https://accounts.google.com https://apis.google.com https://www.gstatic.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://kairos.nixorcorporate.com wss://kairos.nixorcorporate.com https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; media-src 'self' blob:; frame-src 'self' https://accounts.google.com https://drive.google.com https://docs.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://view.officeapps.live.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Resource-Policy
</IfModule>
