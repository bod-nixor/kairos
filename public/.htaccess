Options -Indexes -MultiViews
RewriteEngine On

<IfModule mod_setenvif.c>
  # Keep CSP connect-src aligned with the deployed host; template this block if WS_PUBLIC_URL uses a different host.
  SetEnvIfNoCase Host "^(.+)$" KAIROS_CSP_CONNECT_HTTPS=https://$1 KAIROS_CSP_CONNECT_WSS=wss://$1
</IfModule>

RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(includes|logs)(/|$) - [F,L]
RewriteRule \.(bak|old|orig|tmp|temp|swp|swo|log|sql|ini|conf|ya?ml|lock|dist|backup|zip|tar|tgz|gz)$ - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' %{KAIROS_CSP_CONNECT_HTTPS}e %{KAIROS_CSP_CONNECT_WSS}e https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; frame-src 'self' https://accounts.google.com https://drive.google.com https://docs.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://view.officeapps.live.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Resource-Policy
</IfModule>
