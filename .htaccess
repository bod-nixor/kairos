Options -Indexes -MultiViews
RewriteEngine On

<IfModule mod_setenvif.c>
  # Keep CSP connect-src aligned with the deployed host; template this block if WS_PUBLIC_URL uses a different host.
  SetEnvIfNoCase Host "^(.+)$" KAIROS_CSP_CONNECT_HTTPS=https://$1 KAIROS_CSP_CONNECT_WSS=wss://$1
</IfModule>

# Deny direct access to repository internals when the project root is the
# cPanel document root. Keep .well-known available for hosting challenges.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(\.git|\.env|config|db|docs|sql|src|tools|storage|logs)(/|$) - [F,L]
RewriteRule ^(AGENTS|README|CHANGES_KAIROS|DESIGN_GUIDELINES|THEME_GUIDELINES|UI_UX_CHECKLIST|SECURITY_AUDIT|SECURITY_DEPLOYMENT_CHECKLIST)\.md$ - [F,L]
RewriteRule \.(bak|old|orig|tmp|temp|swp|swo|log|sql|ini|conf|ya?ml|lock|dist|backup|zip|tar|tgz|gz)$ - [F,L]

# Canonical root entrypoint: send site root to /signoff/ once.
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /signoff/ [R=302,L]

# --- WebSocket + emit reverse proxy (must be before RewriteBase/other rules) ---

# Proxy WebSocket: /signoff/ws → ws://127.0.0.1:8090/ws
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^ws$ ws://127.0.0.1:8090/ws [P,L]

# Proxy emit HTTP: /signoff/emit → http://127.0.0.1:8090/emit
RewriteRule ^emit$ http://127.0.0.1:8090/emit [P,L]

RewriteBase /signoff/

# If someone hits /signoff/public/... force clean URL without /public
RewriteCond %{THE_REQUEST} \s/+signoff/public/ [NC]
RewriteRule ^public/(.*)$ $1 [R=301,L]

# API: map /signoff/api/* -> /signoff/public/api/*
RewriteRule ^api/(.*)$ public/api/$1 [L]

# Pretty pages (no .html in location bar)
RewriteRule ^$ public/index.html [L]
RewriteRule ^ta/?$ public/ta.html [L]
RewriteRule ^manager/?$ public/manager.html [L]
RewriteRule ^admin/?$ public/admin.html [L]
RewriteRule ^room/?$ public/room.html [L]

# Fallback: if not a real file/dir, serve from /public
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' %{KAIROS_CSP_CONNECT_HTTPS}e %{KAIROS_CSP_CONNECT_WSS}e https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; frame-src 'self' https://accounts.google.com https://drive.google.com https://docs.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://view.officeapps.live.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Resource-Policy
</IfModule>
