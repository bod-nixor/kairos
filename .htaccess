Options -Indexes -MultiViews
RewriteEngine On

# Deny direct access to repository internals when the project root is the
# cPanel document root. Keep .well-known available for hosting challenges.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(\.git|\.env|config|db|docs|sql|src|templates|tools|storage|logs|vendor)(/|$) - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule ^(AGENTS|README|CHANGES_KAIROS|DESIGN_GUIDELINES|THEME_GUIDELINES|UI_UX_CHECKLIST|SECURITY_AUDIT|SECURITY_DEPLOYMENT_CHECKLIST)\.md$ - [F,L]
RewriteRule \.(bak|old|orig|tmp|temp|swp|swo|log|sql|ini|conf|ya?ml|lock|dist|backup|zip|tar|tgz|gz)$ - [F,L]

# Canonical root entrypoint: send site root to /signoff/ once.
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /signoff/ [R=302,L]

# --- WebSocket + emit reverse proxy (must be before RewriteBase/other rules) ---

# Proxy Socket.IO realtime traffic at the same path advertised by api/config.php and api/me.php.
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^websocket/socket\.io/?(.*)$ ws://127.0.0.1:8090/websocket/socket.io/$1 [P,L,QSA]

# Socket.IO may start with HTTP polling before upgrading, and diagnostics use polling too.
RewriteRule ^websocket/socket\.io/?(.*)$ http://127.0.0.1:8090/websocket/socket.io/$1 [P,L,QSA]

# Legacy direct WebSocket/emit endpoints retained for older clients and operational tooling.
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^ws$ ws://127.0.0.1:8090/ws [P,L]

# Proxy emit HTTP: /signoff/emit → http://127.0.0.1:8090/emit
RewriteRule ^emit$ http://127.0.0.1:8090/emit [P,L]

RewriteBase /signoff/

# If someone hits /signoff/public/... force clean URL without /public
RewriteCond %{THE_REQUEST} \s/+signoff/public/ [NC]
RewriteRule ^public/(.*)$ $1 [R=301,L]

# API: map /signoff/api/* -> /signoff/public/api/*
RewriteRule ^api/(.*)$ public/api/$1 [L]

# HTML pages are templates outside the public webroot. Route only the known
# page names through PHP so every HTML response gets a fresh CSP nonce.
RewriteRule ^$ public/html.php?page=index [END,QSA]
RewriteRule ^(activate|admin|analytics|assignment|assignments|course|forgot-password|grading|index|lesson|manager|modules|projector|quiz|quizzes|resource-viewer|reset-password|room|settings|ta)(?:\.html)?/?$ public/html.php?page=$1 [END,QSA]

# Fallback: if not a real file/dir, serve from /public
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Resource-Policy
</IfModule>
