APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_ORIGIN=https://kairos.nixorcorporate.com
PUBLIC_APP_ORIGIN=https://kairos.nixorcorporate.com

# Feature flags and debugging
KAIROS_DEBUG=false
ENABLE_ADMIN_DIAGNOSTICS=false

# Session configuration
SESSION_COOKIE_NAME=kairos_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
TRUST_PROXY_HEADERS=false

# Google Workspace domain allowed to authenticate
ALLOWED_DOMAIN=nixorcollege.edu.pk

# Default role assigned to new users during authentication
DEFAULT_ROLE_NAME=student

# OAuth client ID used by the front-end and API
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
AUTH_RATE_LIMIT_ATTEMPTS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Browser/API request policy
# Comma-separated exact origins. Keep empty when only APP_ORIGIN/current host is allowed.
CORS_ALLOWED_ORIGINS=
CSRF_REQUIRE_ORIGIN=false
API_MAX_BODY_BYTES=1048576
UPLOAD_MAX_BYTES=26214400
LMS_RESOURCE_UPLOAD_MAX_BYTES=26214400
LMS_UPLOAD_MAX_BYTES=10485760

# WebSocket relay configuration
WS_SHARED_SECRET=replace-with-32-byte-random-hex-secret
WS_TOKEN_TTL=600
WS_SOCKET_PATH=/websocket/socket.io/
WS_PUBLIC_URL=wss://kairos.nixorcorporate.com
WS_ALLOWED_ORIGINS=https://kairos.nixorcorporate.com
WS_EMIT_MAX_BYTES=65536
WS_LOG_DEBUG=false
WS_EMIT_BIN=
WS_PYTHON_BIN=python3

# Google Drive integration placeholders
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_BASE_FOLDER_ID=
LMS_DRIVE_PREVIEW_BASE=https://drive.google.com/file/d/

# Database configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kairos
DB_USERNAME=kairos_app
DB_PASSWORD=replace-with-strong-database-password
DB_CHARSET=utf8mb4
# Enable persistent connections ("true" to enable, blank/false to disable)
DB_PERSISTENT=false
# Alternatively, supply a full DSN string:
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=kairos;charset=utf8mb4
