APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_ORIGIN=https://kairos.nixorcorporate.com
PUBLIC_APP_ORIGIN=https://kairos.nixorcorporate.com

# Feature flags and debugging
KAIROS_DEBUG=false
ENABLE_ADMIN_DIAGNOSTICS=false

# Session configuration
SESSION_COOKIE_NAME=kairos_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
TRUST_PROXY_HEADERS=false

# Google Workspace domain allowed to authenticate
ALLOWED_DOMAIN=nixorcollege.edu.pk

# Default role assigned to new users during authentication
DEFAULT_ROLE_NAME=student

# OAuth client ID used by the front-end and API
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
AUTH_RATE_LIMIT_ATTEMPTS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Admin-invited local authentication. Keep disabled until the migration,
# mail transport, secrets, and staging smoke tests are complete.
LOCAL_AUTH_ENABLED=false
APP_BASE_PATH=/signoff/
# Generate a 64-character hex secret with: openssl rand -hex 32
AUTH_PRIVACY_HASH_SECRET=replace-with-at-least-32-random-characters
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_THREADS=1
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=1024
AUTH_ACTIVATION_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=3600
AUTH_GOOGLE_LINK_TTL_SECONDS=600
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTIFIER_LIMIT=10
LOCAL_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOCAL_AUTH_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_ACCOUNT_FAILURE_THRESHOLD=8
AUTH_ACCOUNT_LOCK_SECONDS=900

# PHP mail() transport used for activation/reset/security notifications.
MAIL_FROM_ADDRESS=kairos@example.edu
MAIL_FROM_NAME=Kairos
SUPPORT_EMAIL=support@example.edu

# Browser/API request policy
# Comma-separated exact origins. Keep empty when only APP_ORIGIN/current host is allowed.
CORS_ALLOWED_ORIGINS=
CSRF_REQUIRE_ORIGIN=false
API_MAX_BODY_BYTES=1048576
UPLOAD_MAX_BYTES=26214400
LMS_RESOURCE_UPLOAD_MAX_BYTES=26214400
LMS_UPLOAD_MAX_BYTES=10485760

# WebSocket relay configuration
WS_SHARED_SECRET=replace-with-32-byte-random-hex-secret
WS_TOKEN_TTL=600
WS_SOCKET_PATH=/websocket/socket.io/
WS_PUBLIC_URL=wss://kairos.nixorcorporate.com
WS_ALLOWED_ORIGINS=https://kairos.nixorcorporate.com
WS_EMIT_MAX_BYTES=65536
WS_LOG_DEBUG=false
WS_EMIT_BIN=
WS_PYTHON_BIN=python3

# Private Google Drive storage
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_WRITES_ENABLED=false
GOOGLE_DRIVE_AUTH_MODE=service_account
# Absolute path outside the Kairos project/web root; never commit this JSON key.
GOOGLE_DRIVE_CREDENTIALS_PATH=/home/account/private/kairos-drive-service-account.json
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_MAX_UPLOAD_BYTES=26214400

# Database configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kairos
DB_USERNAME=kairos_app
DB_PASSWORD=replace-with-strong-database-password
DB_CHARSET=utf8mb4
# Enable persistent connections ("true" to enable, blank/false to disable)
DB_PERSISTENT=false
# Alternatively, supply a full DSN string:
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=kairos;charset=utf8mb4
